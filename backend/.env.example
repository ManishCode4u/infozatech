# =============================================================================
# InfozaTech Backend Environment Variables
# =============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Configuration (REQUIRED for Verification Persistence)
# Get these from: Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Allowed CORS Origin (e.g., https://infozatech.com or * for testing)
FRONTEND_URL=*

# Email Configuration (Nodemailer for Leads & Contacts)
EMAIL_USER=teaminfozatech@gmail.com
EMAIL_PASS=your-app-password
